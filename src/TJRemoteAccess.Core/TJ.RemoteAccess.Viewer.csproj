<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <Version>0.5.2-preview</Version>
    <AssemblyVersion>0.5.2.0</AssemblyVersion>
    <FileVersion>0.5.2.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TJ.RemoteAccess.Viewer</AssemblyName>
    <RootNamespace>TJ.RemoteAccess.Lab</RootNamespace>
    <DefineConstants>$(DefineConstants);TJRA_STANDALONE_PREVIEW</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LabProtocol.cs" />
    <Compile Include="LabCertificates.cs" />
    <Compile Include="LabViewerProfiles.cs" />
    <Compile Include="LabViewerLaunch.cs" />
    <Compile Include="LabViewerProfileDialogs.cs" />
    <Compile Include="LabViewerPasswordDialogs.cs" />
    <Compile Include="LabQuickPasswordTrust.cs" />
    <Compile Include="LabViewerQuickPasswordDialog.cs" />
    <Compile Include="LabViewer.cs" />
  </ItemGroup>
</Project>