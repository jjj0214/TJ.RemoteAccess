<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <Version>0.5.2-preview</Version>
    <AssemblyVersion>0.5.2.0</AssemblyVersion>
    <FileVersion>0.5.2.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TJ.RemoteAccess.Server</AssemblyName>
    <RootNamespace>TJ.RemoteAccess.Lab</RootNamespace>
    <DefineConstants>$(DefineConstants);TJRA_STANDALONE_PREVIEW</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LabProtocol.cs" />
    <Compile Include="LabCertificates.cs" />
    <Compile Include="LabServer.cs" />
    <Compile Include="LabServerTray.cs" />
    <Compile Include="M3InteractiveDesktopGuard.cs" />
    <Compile Include="M3DesktopEnrollment.cs" />
    <Compile Include="LabServerLaunch.cs" />
    <Compile Include="LabAuditWriter.cs" />
    <Compile Include="LabServerClients.cs" />
    <Compile Include="LabServerClientAccessForm.cs" />
    <Compile Include="LabClientPairing.cs" />
    <Compile Include="LabClientPairingDialog.cs" />
    <Compile Include="LabPasswordAccess.cs" />
    <Compile Include="LabPasswordAccessDialog.cs" />
    <Compile Include="LabSharedFrames.cs" />
  </ItemGroup>
</Project>