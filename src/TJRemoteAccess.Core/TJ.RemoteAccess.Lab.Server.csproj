    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TJ.RemoteAccess.Lab.Server</AssemblyName>
    <RootNamespace>TJ.RemoteAccess.Lab</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LabProtocol.cs" />
    <Compile Include="LabCertificates.cs" />
    <Compile Include="LabServer.cs" />
    <Compile Include="LabServerLaunch.cs" />
    <Compile Include="LabAuditWriter.cs" />
    <Compile Include="LabServerClients.cs" />
    <Compile Include="LabServerClientAccessForm.cs" />
    <Compile Include="LabClientPairing.cs" />
    <Compile Include="LabClientPairingDialog.cs" />
    <Compile Include="LabPasswordAccess.cs" />
    <Compile Include="LabPasswordAccessDialog.cs" />
    <Compile Include="LabSharedFrames.cs" />
  </ItemGroup>
</Project>
