<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <Version>0.5.2-preview</Version>
    <AssemblyVersion>0.5.2.0</AssemblyVersion>
    <FileVersion>0.5.2.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);TJRA_STANDALONE_PREVIEW</DefineConstants>
    <AssemblyName>TJ.RemoteAccess.M3.Agent</AssemblyName>
    <RootNamespace>TJ.RemoteAccess.M3</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="M3IpcProtocol.cs" />
    <Compile Include="M3WindowsPipe.cs" />
    <Compile Include="M3SessionAgent.cs" />
    <Compile Include="M3DesktopEnrollment.cs" />
    <Compile Include="M3SupervisedDesktopHost.cs" />
    <Compile Include="M3InteractiveDesktopGuard.cs" />
    <Compile Include="LabCertificates.cs" />
  </ItemGroup>
</Project>