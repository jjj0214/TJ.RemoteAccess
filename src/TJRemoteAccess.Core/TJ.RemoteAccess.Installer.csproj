<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TJ.RemoteAccess.Installer</AssemblyName>
    <RootNamespace>TJ.RemoteAccess.Installer</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.5.3-preview</Version>
    <AssemblyVersion>0.5.3.0</AssemblyVersion>
    <FileVersion>0.5.3.0</FileVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PreviewInstallerCore.cs" />
    <Compile Include="PreviewInstallerForm.cs" />
  </ItemGroup>
</Project>
