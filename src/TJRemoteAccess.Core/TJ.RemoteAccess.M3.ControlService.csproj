<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <Version>0.5.3-preview</Version>
    <AssemblyVersion>0.5.3.0</AssemblyVersion>
    <FileVersion>0.5.3.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TJ.RemoteAccess.M3.ControlService</AssemblyName>
    <RootNamespace>TJ.RemoteAccess.M3</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <Compile Include="M3ControlService.cs" />
    <Compile Include="M3WindowsSessionLauncher.cs" />
    <Compile Include="M3SessionLifecycle.cs" />
    <Compile Include="M3ServiceStatus.cs" />
    <Compile Include="M3ServiceSessionPolicy.cs" />
    <Compile Include="M3ServiceHostPolicy.cs" />
    <Compile Include="M3IpcProtocol.cs" />
    <Compile Include="M3WindowsPipe.cs" />
  </ItemGroup>
</Project>